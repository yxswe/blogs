---
import type { Locale, Post } from '../lib/posts';
import { getDate, getDescription, getLanguage, getReadingTime, getSlug, getTags, getTitle } from '../lib/posts';
import { t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { locale: Locale; posts: Post[]; }
const { locale, posts } = Astro.props;
const copy = t(locale);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const tags = [...new Set(posts.flatMap(getTags))];
const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout locale={locale} categories={tags}>
  <div class="page-topbar">
    <label class="search-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
      <span class="sr-only">{copy.search}</span>
      <input class="search" type="search" placeholder={copy.search} autocomplete="off" />
    </label>
  </div>

  <div class="home-content">
    <section class="writing" id="writing">
      <h1 class="sr-only">{locale === 'zh' ? '文章' : 'Writing'}</h1>
      <div class="post-list">
        {posts.map((post) => {
          const language = getLanguage(post);
          const date = getDate(post);
          const searchable = `${getTitle(post)} ${getDescription(post)} ${getTags(post).join(' ')}`.toLowerCase();
          const filters = [language, ...getTags(post).map(tag => tag.toLowerCase())].join(' ');
          return (
            <article class="post-card-wrap" data-search={searchable} data-filters={filters}>
              <a class="post-card" href={`${base}posts/${getSlug(post)}/`}>
                <span class="card-marker" aria-hidden="true"></span>
                <div class="post-card-heading">
                  <h2>{getTitle(post)}</h2>
                  <span class="lang-badge">{language === 'zh' ? '中文' : 'EN'}</span>
                </div>
                <p>{getDescription(post)}</p>
                <div class="post-meta">
                  <span><i aria-hidden="true">▣</i>{date ? dateFormatter.format(date) : getReadingTime(post, locale)}</span>
                  <span><i aria-hidden="true">▱</i>{getTags(post).join(', ')}</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
      <p class="empty">{copy.empty}</p>
    </section>

  </div>

  <script>
    const search = document.querySelector<HTMLInputElement>('.search');
    const cards = [...document.querySelectorAll<HTMLElement>('.post-card-wrap')];
    const empty = document.querySelector<HTMLElement>('.empty');
    const filterLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-filter]')];
    let active = new URLSearchParams(window.location.search).get('tag')?.toLowerCase() || 'all';

    const update = () => {
      const query = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach(card => {
        const inFilter = active === 'all' || card.dataset.filters?.split(' ').includes(active);
        const inSearch = !query || card.dataset.search?.includes(query);
        card.hidden = !(inFilter && inSearch);
        if (!card.hidden) visible++;
      });
      filterLinks.forEach(link => link.classList.toggle('active', link.dataset.sidebarFilter === active));
      if (empty) empty.style.display = visible ? 'none' : 'block';
    };

    filterLinks.forEach(link => link.addEventListener('click', event => {
      event.preventDefault();
      active = link.dataset.sidebarFilter || 'all';
      const url = new URL(window.location.href);
      active === 'all' ? url.searchParams.delete('tag') : url.searchParams.set('tag', active);
      history.replaceState(null, '', `${url.pathname}${url.search}#writing`);
      if (window.matchMedia('(max-width: 820px)').matches && !document.body.classList.contains('sidebar-closed')) {
        document.querySelector<HTMLButtonElement>('.sidebar-toggle')?.click();
      }
      update();
    }));
    search?.addEventListener('input', update);
    update();
  </script>
</BaseLayout>
