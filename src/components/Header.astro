---
import type { Locale } from '../lib/posts';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  localeLinks?: { zh: string; en: string };
  categories?: string[];
}

const { locale, localeLinks, categories = [] } = Astro.props;
const copy = t(locale);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const home = locale === 'zh' ? base : `${base}en/`;
const zhUrl = localeLinks?.zh ?? base;
const enUrl = localeLinks?.en ?? `${base}en/`;
---
<header class="site-header" data-base={base} data-zh-url={zhUrl} data-en-url={enUrl}>
  <button class="sidebar-toggle" type="button" aria-controls="site-sidebar" aria-expanded="true" aria-label={locale === 'zh' ? '收起侧边栏' : 'Collapse sidebar'}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 5h16M4 12h10M4 19h16"></path><path d="m18 9-3 3 3 3"></path>
    </svg>
  </button>
  <button class="sidebar-scrim" type="button" tabindex="-1" aria-label={locale === 'zh' ? '关闭侧边栏' : 'Close sidebar'}></button>

  <aside class="sidebar" id="site-sidebar" aria-label={locale === 'zh' ? '网站导航' : 'Site navigation'}>
    <div class="sidebar-main">
      <div class="profile-block">
        <a class="profile" href={home} aria-label={copy.siteName}>
          <img class="avatar" src={`${base}avatar.svg`} alt="yxswe cartoon avatar" />
        </a>
        <div class="profile-title">
          <a href={home}>yxswe</a>
          <a class="github-icon" href="https://github.com/yxswe" target="_blank" rel="noreferrer" aria-label="yxswe on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.72 0-1.26.45-2.3 1.2-3.1-.13-.3-.53-1.48.1-3.07 0 0 .98-.31 3.19 1.18a11.1 11.1 0 0 1 5.81 0c2.2-1.5 3.18-1.18 3.18-1.18.63 1.6.23 2.78.11 3.07.75.81 1.2 1.84 1.2 3.1 0 4.45-2.71 5.42-5.3 5.7.42.36.8 1.07.8 2.15v3.18c0 .31.2.67.8.56A11.5 11.5 0 0 0 12 .7Z"></path></svg>
          </a>
        </div>
        <p class="sidebar-intro">{locale === 'zh' ? '关于 AI、软件工程与复杂系统的笔记。' : 'Notes on AI, software engineering, and complex systems.'}</p>
      </div>

      <nav class="side-nav" aria-label={locale === 'zh' ? '快速导航' : 'Quick navigation'}>
        <p class="nav-label">{locale === 'zh' ? '快速导航' : 'Quick navigation'}</p>
        <a class="nav-item active" href={`${home}#writing`} data-sidebar-filter="all">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 5h14M7 12h14M7 19h14"></path><path d="M3 5h.01M3 12h.01M3 19h.01"></path></svg>
          <span>{locale === 'zh' ? '全部文章' : 'Overall'}</span>
        </a>
        {categories.length > 0 && (
          <div class="category-nav">
            <button class="nav-item category-toggle" type="button" aria-expanded="false" aria-controls="category-list">
              <span class="nav-item-leading">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"></path></svg>
                <span>{locale === 'zh' ? '文章分类' : 'Category'}</span>
              </span>
              <svg class="category-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </button>
            <div class="category-list" id="category-list" hidden>
              {categories.map(category => (
                <a href={`${home}?tag=${encodeURIComponent(category.toLowerCase())}#writing`} data-sidebar-filter={category.toLowerCase()}>{category}</a>
              ))}
            </div>
          </div>
        )}
      </nav>
    </div>

    <div class="sidebar-bottom">
      <div class="locale-switch" aria-label="Language">
        <a data-locale="auto" href={home}>{locale === 'zh' ? '跟随系统' : 'System'}</a>
        <a data-locale="zh" class:list={{ active: locale === 'zh' }} href={zhUrl} lang="zh">中文</a>
        <a data-locale="en" class:list={{ active: locale === 'en' }} href={enUrl} lang="en">EN</a>
      </div>
      <a class="rss-link" href={`${base}rss.xml`}>RSS</a>
    </div>
  </aside>

  <script>
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) {
      const choices = [...header.querySelectorAll<HTMLAnchorElement>('[data-locale]')];
      const systemLocale = () => navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
      const targetFor = (locale: string) => locale === 'zh' ? header.dataset.zhUrl! : header.dataset.enUrl!;
      const preference = localStorage.getItem('yxswe-locale') || 'auto';
      choices.forEach(choice => choice.classList.toggle('active', choice.dataset.locale === preference));
      choices.forEach(choice => choice.addEventListener('click', event => {
        event.preventDefault();
        const selected = choice.dataset.locale || 'auto';
        localStorage.setItem('yxswe-locale', selected);
        window.location.href = targetFor(selected === 'auto' ? systemLocale() : selected);
      }));

      const base = header.dataset.base!;
      const path = window.location.pathname.replace(/\/+$/, '/');
      const isHome = path === base || path === `${base}en/`;
      if (preference === 'auto' && isHome) {
        const target = targetFor(systemLocale());
        if (path !== target) window.location.replace(target);
      }

      const toggle = header.querySelector<HTMLButtonElement>('.sidebar-toggle');
      const scrim = header.querySelector<HTMLButtonElement>('.sidebar-scrim');
      const mobile = window.matchMedia('(max-width: 820px)');
      const setSidebar = (open: boolean, remember = false) => {
        document.body.classList.toggle('sidebar-closed', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open
          ? (document.documentElement.lang.startsWith('zh') ? '收起侧边栏' : 'Collapse sidebar')
          : (document.documentElement.lang.startsWith('zh') ? '展开侧边栏' : 'Open sidebar'));
        if (remember && !mobile.matches) localStorage.setItem('yxswe-sidebar', open ? 'open' : 'closed');
      };
      setSidebar(mobile.matches ? false : localStorage.getItem('yxswe-sidebar') !== 'closed');
      toggle?.addEventListener('click', () => setSidebar(document.body.classList.contains('sidebar-closed'), true));
      scrim?.addEventListener('click', () => setSidebar(false));
      mobile.addEventListener('change', event => setSidebar(event.matches ? false : localStorage.getItem('yxswe-sidebar') !== 'closed'));

      const categoryToggle = header.querySelector<HTMLButtonElement>('.category-toggle');
      const categoryList = header.querySelector<HTMLElement>('.category-list');
      categoryToggle?.addEventListener('click', () => {
        const expanded = categoryToggle.getAttribute('aria-expanded') === 'true';
        categoryToggle.setAttribute('aria-expanded', String(!expanded));
        if (categoryList) categoryList.hidden = expanded;
      });
    }
  </script>
</header>
