---
import type { Locale } from '../lib/posts';
import { t } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = t(locale);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const home = locale === 'zh' ? base : `${base}en/`;
---
<header class="site-header">
  <div class="mobile-bar">
    <a class="mobile-brand" href={home}>Yangxiao</a>
    <div class="locale-switch" aria-label="Language">
      <a class:list={{ active: locale === 'zh' }} href={base} lang="zh">中</a>
      <a class:list={{ active: locale === 'en' }} href={`${base}en/`} lang="en">EN</a>
    </div>
  </div>
  <aside class="sidebar" aria-label="Sidebar">
    <div>
      <a class="profile" href={home} aria-label={copy.siteName}>
        <span class="avatar">YX</span>
        <strong>Yangxiao</strong>
      </a>
      <p class="sidebar-intro">{locale === 'zh' ? '记录 AI、软件工程与复杂系统。' : 'Notes on AI, software engineering, and complex systems.'}</p>
      <nav class="side-nav" aria-label="Main navigation">
        <a href={`${home}#writing`}><span>⌂</span>{copy.navWriting}</a>
        <a href={`${home}#about`}><span>○</span>{copy.navAbout}</a>
        <a href="https://github.com/yxswe/blogs" target="_blank" rel="noreferrer"><span>↗</span>{copy.navSource}</a>
      </nav>
    </div>
    <div class="sidebar-bottom">
      <div class="locale-switch" aria-label="Language">
        <a class:list={{ active: locale === 'zh' }} href={base} lang="zh">中文</a>
        <a class:list={{ active: locale === 'en' }} href={`${base}en/`} lang="en">English</a>
      </div>
      <a href={`${base}rss.xml`}>RSS</a>
    </div>
  </aside>
</header>
